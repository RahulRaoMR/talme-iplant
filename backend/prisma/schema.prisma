generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AuthUser {
  id           BigInt   @id @default(autoincrement())
  fullName     String   @map("full_name")
  email        String
  phone        String
  passwordHash String   @map("password_hash")
  role         String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  isActive     Boolean  @default(false) @map("is_active")
  approvalStatus String @default("PENDING") @map("approval_status")
  deletedAt    DateTime? @map("deleted_at")
  registrationReviews AuthRegistrationReview[] @relation("RegistrationTarget")
  reviewedRegistrations AuthRegistrationReview[] @relation("RegistrationReviewer")
  passwordOtps AuthPasswordOtp[]
  createdEmployeeAudits EmployeeRecordAudit[] @relation("EmployeeAuditCreatedBy")
  lastEditedEmployeeAudits EmployeeRecordAudit[] @relation("EmployeeAuditLastEditedBy")

  @@index([email, role])
  @@index([approvalStatus], map: "auth_users_approval_status_idx")
  @@map("auth_users")
}

model AuthRegistrationReview {
  id BigInt @id @default(autoincrement())
  authUserId BigInt @map("auth_user_id")
  reviewerAuthUserId BigInt? @map("reviewer_auth_user_id")
  previousStatus String @map("previous_status")
  status String
  createdAt DateTime @default(now()) @map("created_at")
  authUser AuthUser @relation("RegistrationTarget", fields: [authUserId], references: [id], onDelete: Cascade)
  reviewer AuthUser? @relation("RegistrationReviewer", fields: [reviewerAuthUserId], references: [id], onDelete: SetNull)

  @@index([authUserId, createdAt], map: "auth_registration_reviews_user_idx")
  @@map("auth_registration_reviews")
}

model AuthSession {
  id               BigInt    @id @default(autoincrement())
  sessionKey       String    @unique @map("session_key")
  email            String
  role             String?
  refreshTokenHash String    @unique @map("refresh_token_hash")
  csrfToken        String    @map("csrf_token")
  rememberMe       Boolean   @default(false) @map("remember_me")
  expiresAt        DateTime  @map("expires_at")
  lastSeenAt       DateTime  @default(now()) @map("last_seen_at")
  revokedAt        DateTime? @map("revoked_at")
  ipAddress        String?   @map("ip_address")
  userAgent        String?   @map("user_agent")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([email])
  @@map("auth_sessions")
}

model AuthSecurityLimit {
  key String @id
  attempts Int @default(0)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  @@index([expiresAt], map: "auth_security_limits_expiry_idx")
  @@map("auth_security_limits")
}

model AuthPasswordOtp {
  id             BigInt    @id @default(autoincrement())
  authUserId     BigInt    @map("auth_user_id")
  email          String
  otpHash        String    @map("otp_hash")
  resetTokenHash String?   @map("reset_token_hash")
  expiresAt      DateTime  @map("expires_at")
  resetExpiresAt DateTime? @map("reset_expires_at")
  verifiedAt     DateTime? @map("verified_at")
  usedAt         DateTime? @map("used_at")
  attemptCount   Int       @default(0) @map("attempt_count")
  requestIp      String?   @map("request_ip")
  userAgent      String?   @map("user_agent")
  createdAt      DateTime  @default(now()) @map("created_at")
  authUser       AuthUser  @relation(fields: [authUserId], references: [id], onDelete: Cascade)

  @@index([authUserId, usedAt, expiresAt], map: "auth_password_otps_user_active_idx")
  @@index([email, createdAt], map: "auth_password_otps_email_created_idx")
  @@map("auth_password_otps")
}

model EmployeeRecordAudit {
  recordKey                String    @id @map("record_key")
  employeeUserId           String?   @map("employee_user_id")
  employeeEmail            String?   @map("employee_email")
  employeePhone            String?   @map("employee_phone")
  createdByAuthUserId      BigInt?   @map("created_by_auth_user_id")
  createdByName            String    @map("created_by_name")
  createdByEmail           String?   @map("created_by_email")
  createdAt                DateTime  @default(now()) @map("created_at")
  lastEditedByAuthUserId   BigInt?   @map("last_edited_by_auth_user_id")
  lastEditedByName         String    @map("last_edited_by_name")
  lastEditedByEmail        String?   @map("last_edited_by_email")
  lastEditedAt             DateTime  @default(now()) @map("last_edited_at")
  lastAction               String    @default("created") @map("last_action")
  createdByAuthUser        AuthUser? @relation("EmployeeAuditCreatedBy", fields: [createdByAuthUserId], references: [id], onDelete: SetNull)
  lastEditedByAuthUser     AuthUser? @relation("EmployeeAuditLastEditedBy", fields: [lastEditedByAuthUserId], references: [id], onDelete: SetNull)

  @@index([employeeEmail], map: "employee_record_audits_employee_email_idx")
  @@map("employee_record_audits")
}

model Candidate {
  id                 String   @id @default(cuid())
  fullName           String
  email              String?  @unique
  phone              String   @unique
  location           String
  keywords           String
  experience         Float?
  currentCompany     String?
  currentDesignation String?
  resumeUrl          String?
  profileImage       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([fullName])
  @@index([phone])
  @@index([email])
  @@index([location])
}

model HrEmployeeImport {
  id             BigInt             @id @default(autoincrement())
  source         String
  generatedAt    DateTime?          @map("generated_at")
  totalRows      Int                @default(0) @map("total_rows")
  importedRows   Int                @default(0) @map("imported_rows")
  skippedRows    Int                @default(0) @map("skipped_rows")
  skippedPreview Json?              @map("skipped_preview")
  createdAt      DateTime           @default(now()) @map("created_at")
  records        HrEmployeeRecord[]

  @@map("hr_employee_imports")
}

model HrEmployeeRecord {
  id                     BigInt            @id @default(autoincrement())
  recordKey              String            @unique @map("record_key")
  sourceType             String            @map("source_type")
  sourceId               String?           @map("source_id")
  sourceFile             String?           @map("source_file")
  rowNumber              Int?              @map("row_number")
  importId               BigInt?           @map("import_id")
  localUserId            BigInt?           @map("local_user_id")
  localEmployeeAccountId BigInt?           @map("local_employee_account_id")
  localCompanyId         BigInt?           @map("local_company_id")
  localRoleId            BigInt?           @map("local_role_id")
  localRoleCompanyId     BigInt?           @map("local_role_company_id")
  localRoleAssignedAt    DateTime?         @map("local_role_assigned_at")
  employeeCode           String?           @map("employee_code")
  name                   String
  email                  String?
  phone                  String?
  status                 String            @default("active")
  emailVerified          Boolean?          @map("email_verified")
  phoneVerified          Boolean?          @map("phone_verified")
  designation            String?
  department             String?
  location               String?
  keywords               String?
  experience             Float?
  currentCompany         String?           @map("current_company")
  currentDesignation     String?           @map("current_designation")
  cvFileName             String?           @map("cv_file_name")
  cvStoredName           String?           @map("cv_stored_name")
  resumeS3Key            String?           @map("resume_s3_key")
  sourceCreatedAt        DateTime?         @map("source_created_at")
  sourceUpdatedAt        DateTime?         @map("source_updated_at")
  sourcePayload          Json?             @map("source_payload")
  createdAt              DateTime          @default(now()) @map("created_at")
  updatedAt              DateTime          @default(now()) @updatedAt @map("updated_at")
  archivedAt             DateTime?         @map("archived_at")
  import                 HrEmployeeImport? @relation(fields: [importId], references: [id], onDelete: SetNull)
  resumes                HrEmployeeResume[]
  employeeSkills         EmployeeSkill[]

  @@index([sourceType], map: "hr_employee_records_source_type_idx")
  @@index([sourceId], map: "hr_employee_records_source_id_idx")
  @@index([localUserId], map: "hr_employee_records_local_user_id_idx")
  @@index([email], map: "hr_employee_records_email_idx")
  @@index([phone], map: "hr_employee_records_phone_idx")
  @@index([name], map: "hr_employee_records_name_idx")
  @@index([resumeS3Key], map: "hr_employee_records_resume_s3_key_idx")
  @@map("hr_employee_records")
}


model HrEmployeeResume {
  id                BigInt             @id @default(autoincrement())
  employeeRecordId  BigInt             @map("employee_record_id")
  fileName          String?            @map("file_name")
  filePath          String?            @map("file_path")
  fileUrl           String?            @map("file_url")
  storageProvider   String             @default("local") @map("storage_provider")
  storageKey        String?            @map("storage_key")
  extractedText     String?            @map("extracted_text")
  isLatest          Boolean            @default(true) @map("is_latest")
  uploadedAt        DateTime           @default(now()) @map("uploaded_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  employeeRecord    HrEmployeeRecord   @relation(fields: [employeeRecordId], references: [id], onDelete: Cascade)
  employeeSkills    EmployeeSkill[]

  @@index([employeeRecordId], map: "hr_employee_resumes_employee_idx")
  @@index([uploadedAt], map: "hr_employee_resumes_uploaded_idx")
  @@map("hr_employee_resumes")
}

model Skill {
  id              BigInt          @id @default(autoincrement())
  skillName       String          @map("skill_name")
  normalizedName  String          @unique @map("normalized_name")
  createdAt       DateTime        @default(now()) @map("created_at")
  employeeSkills  EmployeeSkill[]

  @@map("skills")
}

model EmployeeSkill {
  id                BigInt            @id @default(autoincrement())
  employeeRecordId  BigInt            @map("employee_record_id")
  skillId           BigInt            @map("skill_id")
  resumeId          BigInt?           @map("resume_id")
  yearsOfExperience Float?            @map("years_of_experience")
  createdAt         DateTime          @default(now()) @map("created_at")
  employeeRecord    HrEmployeeRecord  @relation(fields: [employeeRecordId], references: [id], onDelete: Cascade)
  skill             Skill             @relation(fields: [skillId], references: [id], onDelete: Cascade)
  resume            HrEmployeeResume? @relation(fields: [resumeId], references: [id], onDelete: SetNull)

  @@index([employeeRecordId], map: "employee_skills_employee_idx")
  @@index([skillId], map: "employee_skills_skill_idx")
  @@index([resumeId], map: "employee_skills_resume_idx")
  @@map("employee_skills")
}
