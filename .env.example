NODE_ENV=development
PORT=4000
# Comma-separated trusted reverse-proxy IPs/CIDRs, or loopback for a local proxy.
# Leave empty for direct connections. Never trust client-supplied forwarding headers.
TRUST_PROXY=
# Google Cloud AlloyDB for PostgreSQL. Do not commit real credentials.
DATABASE_URL="postgresql://DATABASE_USER:DATABASE_PASSWORD@DATABASE_HOST:5432/iplante?sslmode=require"
DATABASE_HOST="YOUR_ALLOYDB_HOST_OR_PRIVATE_IP"
DATABASE_PORT=5432
DATABASE_NAME="iplante"
DATABASE_USER="YOUR_DATABASE_USER"
DATABASE_PASSWORD="YOUR_DATABASE_PASSWORD"

JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="1d"
RESEND_API_KEY="replace-with-your-resend-api-key"
RESEND_FROM_EMAIL=noreply@iplant.talme.in
AUTH_EMAIL_FROM="Talme HR <noreply@iplant.talme.in>"
APP_URL="https://iplant.talme.in"

CORS_ORIGIN="http://localhost:4000"
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

BACKEND_PORT=5000
